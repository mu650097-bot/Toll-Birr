# Telegram
BOT_TOKEN=REPLACE_WITH_REAL_BOT_TOKEN
ADMIN_ID=REPLACE_WITH_TELEGRAM_ADMIN_ID
OWNER_ID=REPLACE_WITH_TELEGRAM_OWNER_ID

# Wallet/payment display
ACCOUNT_NAME=REPLACE_WITH_ACCOUNT_NAME
CBE_ACCOUNT=REPLACE_WITH_CBE_ACCOUNT
BOA_ACCOUNT=REPLACE_WITH_BOA_ACCOUNT
TELEBIRR_NUMBER=REPLACE_WITH_TELEBIRR_NUMBER

# Mini App - both must be public HTTPS in production
MINI_APP_URL=https://your-miniapp-domain.example/
MINI_APP_API_URL=https://your-miniapp-domain.example/api
MINI_APP_DIR=.
BOT_USERNAME=your_bot_username_without_at_sign

# Security
ADMIN_PANEL_PIN=REPLACE_WITH_STRONG_ADMIN_PIN
SUPPORT_CONTACT=@your_support

# Database
DB_FILE=auction_wallet.db

# Public domain / reverse proxy
DOMAIN=your-miniapp-domain.example

# Optional Chapa
CHAPA_SECRET_KEY=
CHAPA_MODE=test
CHAPA_CALLBACK_URL=https://your-miniapp-domain.example/api/payments/chapa/callback
CHAPA_RETURN_URL=https://your-miniapp-domain.example/
CHAPA_WEBHOOK_SECRET=

# Optional backup/runtime
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Hard maximum paid out for a single game round. Keep it ~2-5% of your REAL bankroll
# (and set per-game max bet in the Admin Panel so max_stake x top multiplier stays below it).
MAX_ROUND_PAYOUT_ETB=100000

# Highest house edge admins may set (0.30 = min 70% RTP)
MAX_HOUSE_EDGE=0.30

# Sports = pool (parimutuel): house takes this rake (0.05-0.10) from each match pool, winners share the rest.
SPORTS_RAKE_PCT=0.08
# Number + Boom pool games: house rake on each entry (0.05-0.10); Number round length in seconds
GAME_POOL_RAKE_PCT=0.08
NUMBER_ROUND_SECONDS=60

# Minimum bookmaker overround for sports matches (1/H+1/D+1/A)
SPORTS_MIN_OVERROUND=1.02

# Risk controls (0 = disabled). Set PLATFORM_BANKROLL_ETB to your real available bankroll.
# REQUIRED BEFORE LAUNCH: set to money actually available to pay winners.
PLATFORM_BANKROLL_ETB=0
BANKROLL_EXPOSURE_PCT=0.5
# One round may never pay more than this share of PLATFORM_BANKROLL_ETB (recommended 0.02-0.05)
MAX_PAYOUT_BANKROLL_PCT=0.03
# Wager at least N x real deposits before withdrawing (bonus excluded). 0 = off.
# The 10% deposit bonus has no wagering condition, so this rule pays for it.
# Simulation: break-even ~1.2x (avg 8.2% edge), ~2x on 5%-edge games -> use 3.
WITHDRAW_TURNOVER_MULTIPLIER=0

# WebRTC TURN relay (required for calls between mobile networks)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Generic payment-provider webhook (leave manual/empty unless used)
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=

# Realtime round / call timeouts (seconds)
REALTIME_ROUND_TIMEOUT_SEC=120
CALL_SESSION_TIMEOUT_SEC=7200

# Demo-only: seed 4 fake marketplace listings on an EMPTY db. Keep 0 in production.
SEED_DEMO_MARKETPLACE=0

# Optional Telegram channel/group ID for admin announcement publishing.
# Add the bot as an administrator in that channel first.
ANNOUNCEMENT_CHANNEL_ID=

# Withdrawals: minimum in ETB; daily caps (0 = no cap)
MIN_WITHDRAW_AMOUNT=1
MAX_WITHDRAWALS_PER_DAY=0
MAX_WITHDRAWAL_AMOUNT_PER_DAY=0

# Marketplace: 1 = text-only listings go live immediately (media listings are always reviewed)
MARKETPLACE_AUTO_APPROVE_TEXT_ONLY=0
